{
  "name": "opencode-logi-companion",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode Logi Companion plugin for OpenCode v1 that forwards notification events to a local Logitech haptics bridge",
  "main": "src/index.js",
  "exports": {".": "./src/index.js"},
  "dependencies": {"@opencode-logi-companion/core": "file:../packages/haptics-core"},
  "bundledDependencies": ["@opencode-logi-companion/core"],
  "files": ["src", "examples", "README.md", "config.example.json"],
  "keywords": ["opencode", "plugin", "logi", "logitech", "haptics", "mx-master-4", "mx-4"],
  "scripts": {"pretest": "node scripts/bundle-core.mjs", "test": "node --test", "prepack": "node scripts/bundle-core.mjs"},
  "engines": {"node": ">=20"}
}
